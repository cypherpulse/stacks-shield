# =============================================================================
# Stacks Shield -- v2 (C-1 fix) FRESH testnet deployment configuration
# =============================================================================
# This single file drives the WHOLE v2 relaunch under a NEW deployer wallet:
#   - the native STX core (deploy:testnet -> deploy-all.ts)
#   - the SIP-10 stack     (scripts/deployment/sip10/*)
# Both read this file (the STX path via DEPLOY_ENV_FILE default; the SIP-10 path
# hardcodes .env.v2.deploy). Copy to .env.v2.deploy and fill in:
#   cp .env.v2.deploy.example .env.v2.deploy
# .env.* is gitignored -- NEVER commit .env.v2.deploy.
#
# WHY A NEW WALLET: the v2 contracts are deployed FRESH. `.privacy-registry` /
# `.note-manager` inside the pools resolve under the SAME deploying account, so a
# new deployer means the entire stack (registry, note-manager, pools, verifiers)
# is redeployed under it, on a fresh empty tree. The old (C-1) testnet
# deployment is simply abandoned.

# -----------------------------------------------------------------------------
# Deployer -- the NEW v2 wallet (generate with scripts/deployment/new-wallet.ts)
# -----------------------------------------------------------------------------
# Fund NEW_DEPLOYER_ADDRESS from the testnet faucet before deploying (needs
# ~15+ STX for ~11 contract deploys):
#   https://explorer.hiro.so/sandbox/faucet?chain=testnet
NEW_DEPLOYER_MNEMONIC=
NEW_DEPLOYER_ADDRESS=

STACKS_NETWORK=testnet
STACKS_API_URL=https://api.testnet.hiro.so
# The SIP-10 scripts read this key for the same value:
CORE_API_URL=https://api.testnet.hiro.so
# Optional: raises Hiro API rate limits
HIRO_API_KEY=

# -----------------------------------------------------------------------------
# Protocol configuration (shared)
# -----------------------------------------------------------------------------
# Receives protocol fees. Defaults to the deployer if unset.
TREASURY_ADDRESS=
FEE_RECIPIENT=
# Principal allowed to publish zkVerify aggregation roots (liveness role only).
# Defaults to the deployer if unset (used only by the initial wire step).
AGGREGATION_RELAYER=
RELAYER_ADDRESS=

# ---- dedicated relayers (NOT the deployer) ----------------------------------
# Mint with:   npx tsx scripts/deployment/gen-relayers.ts
# Seat on both verifiers with:  npx tsx scripts/deployment/set-relayers.ts
# Comma-separated relayer principals seated as aggregation relayers on BOTH the
# native zk-verifier and the sip10-zk-verifier:
RELAYER_ADDRESSES=
# Remove the deployer from the relayer set once the above are seated:
RELAYER_DROP_DEPLOYER=true
# Extra addresses to remove from the relayer set (e.g. a leftover seeded at
# deploy/configure time via AGGREGATION_RELAYER / RELAYER_ADDRESS). Comma-sep.
RELAYER_REMOVE=

# Empty-tree (genesis) Merkle root -- depth-20 Poseidon tree, UNCHANGED by the
# v2 fix (the tree shape is identical). This is the SDK's CommitmentTree().root.
GENESIS_ROOT=0x2134e76ac5d21aab186c2be1dd8f84ee880a1e46eaf712f9d371b6df22191f3e

# Fee schedule (omit to deploy with zero fees)
SHIELD_FEE_BPS=25
TRANSFER_FEE_FLAT=10000
WITHDRAW_FEE_BPS=30

# =============================================================================
# CIRCUIT VERIFICATION KEYS  --  REGENERATE ALL of these for v2
# =============================================================================
# The v2 circuits changed (they bind the tree insertion), so EVERY verification
# key changes. Recompile + re-register on your toolchain, then paste the hashes:
#   1. nargo compile   (each circuit in zk/circuits/** and zk/circuits/sip10/**)
#   2. bb write_vk      -> the bb.js vkey hash  (<X>_VK_HASH / VKEY_HASH_<X>)
#   3. register the vkey with zkVerify -> its VkRegistered event gives the
#      zkVerify vkey hash (<X>_ZKV_VKEY_HASH) and proof version hash (<X>_VERSION_HASH)
#   4. keccak256(verifier_ctx) for the UltraHonk pallet -> ZKVERIFY_CONTEXT_HASH

# ---- native STX circuits (read by deploy-fresh.ts) --------------------------
# generate-vkeys.ts prints this whole block (VKEY_HASH_* offline; STX_ZKV_VKEY_HASH_*
# with --register). deploy-fresh.ts REQUIRES all of them (no v1 fallback).
VKEY_HASH_SHIELD=
VKEY_HASH_TRANSFER=
VKEY_HASH_WITHDRAW=
VKEY_HASH_SPLIT=
VKEY_HASH_MERGE=
PROOF_LEN_SHIELD=7872
PROOF_LEN_TRANSFER=7872
PROOF_LEN_WITHDRAW=7872
PROOF_LEN_SPLIT=7872
PROOF_LEN_MERGE=7872
STX_ZKV_VKEY_HASH_SHIELD=
STX_ZKV_VKEY_HASH_TRANSFER=
STX_ZKV_VKEY_HASH_WITHDRAW=
STX_ZKV_VKEY_HASH_SPLIT=
STX_ZKV_VKEY_HASH_MERGE=
STX_VERSION_HASH=0x55b52ad2b4153c872e27d688f567c1406f0d93b5528dd2b0bf2a9a40df97f1f9

# ---- SIP-10 circuits (read by register-verification-keys.ts) ----------------
ZKVERIFY_CONTEXT_HASH=
SHIELD_VK_HASH=
SHIELD_ZKV_VKEY_HASH=
SHIELD_VERSION_HASH=
TRANSFER_VK_HASH=
TRANSFER_ZKV_VKEY_HASH=
TRANSFER_VERSION_HASH=
WITHDRAW_VK_HASH=
WITHDRAW_ZKV_VKEY_HASH=
WITHDRAW_VERSION_HASH=
SPLIT_VK_HASH=
SPLIT_ZKV_VKEY_HASH=
SPLIT_VERSION_HASH=
MERGE_VK_HASH=
MERGE_ZKV_VKEY_HASH=
MERGE_VERSION_HASH=

# -----------------------------------------------------------------------------
# zkVerify -- proof verification network
# -----------------------------------------------------------------------------
ZKVERIFY_ENDPOINT=wss://testnet-rpc.zkverify.io
ZKVERIFY_SEED_PHRASE=
ZKVERIFY_DOMAIN_ID=1
CIRCUIT_ARTIFACTS_DIR=zk/circuits

# -----------------------------------------------------------------------------
# SIP-10 assets to register (official testnet token contracts)
# -----------------------------------------------------------------------------
SBTC_CONTRACT=
SBTC_DECIMALS=8
USDCX_CONTRACT=
USDCX_DECIMALS=6
