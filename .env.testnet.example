# =============================================================================
# STX Shield -- Stacks Testnet deployment configuration
# =============================================================================
# Copy to .env.testnet and fill in. NEVER commit .env.testnet.
#   cp .env.testnet.example .env.testnet

STACKS_NETWORK=testnet
STACKS_API_URL=https://api.testnet.hiro.so
# Optional: raises rate limits on the Hiro API
HIRO_API_KEY=

# -----------------------------------------------------------------------------
# Deployer -- must be funded with testnet STX
#   https://explorer.hiro.so/sandbox/faucet?chain=testnet
# -----------------------------------------------------------------------------
DEPLOYER_MNEMONIC=

# -----------------------------------------------------------------------------
# Protocol configuration
# -----------------------------------------------------------------------------
# Receives protocol fees. Defaults to the deployer if unset.
TREASURY_ADDRESS=

# Principal allowed to publish zkVerify aggregation roots. This is a LIVENESS
# role only: it cannot approve, reject, or censor any user transaction, and it
# cannot forge a root (roots are append-only and bind to zkVerify's tree).
# Defaults to the deployer if unset.
AGGREGATION_RELAYER=

# Empty-tree Merkle root, hex. Produced by the SDK's MerkleTree.
GENESIS_ROOT=

# Fee schedule (omit to deploy with zero fees)
SHIELD_FEE_BPS=25
TRANSFER_FEE_FLAT=10000
WITHDRAW_FEE_BPS=30

# -----------------------------------------------------------------------------
# Circuit verification keys
# -----------------------------------------------------------------------------
# The hash of each circuit's verification key AS REGISTERED WITH zkVerify.
# This is the anchor binding a zkVerify statement to this protocol: the
# aggregation leaf commits to it, so a proof verified against a different
# circuit can never be replayed here.
VKEY_HASH_SHIELD=
VKEY_HASH_TRANSFER=
VKEY_HASH_WITHDRAW=
VKEY_HASH_SPLIT=
VKEY_HASH_MERGE=

PROOF_LEN_SHIELD=
PROOF_LEN_TRANSFER=
PROOF_LEN_WITHDRAW=
PROOF_LEN_SPLIT=
PROOF_LEN_MERGE=

# -----------------------------------------------------------------------------
# zkVerify -- proof verification network
# -----------------------------------------------------------------------------
ZKVERIFY_ENDPOINT=wss://testnet-rpc.zkverify.io
# Account that submits proofs to zkVerify (needs zkVerify testnet tokens)
ZKVERIFY_SEED_PHRASE=
# Aggregation domain whose roots are relayed to the Stacks verifier
ZKVERIFY_DOMAIN_ID=1

# Root of the compiled Noir circuits (each at <circuit>/target/<pkg>.json)
CIRCUIT_ARTIFACTS_DIR=zk/circuits

# =============================================================================
# RELAYER (sender privacy)
# =============================================================================
# A relayer submits a user's transfer/withdraw/split/merge and pays the Stacks
# fee, so the chain sees ONLY the relayer's address -- never the user's.
#
# The relayer is TRUSTLESS: every operation parameter is bound into the
# zkVerify statement the contracts re-derive, so a relayer that alters an
# amount, recipient, commitment or nullifier simply produces a transaction
# that reverts. It can submit or not submit; nothing else.
#
# NOTE: shield is intentionally NOT relayable -- it moves STX from the caller,
# so the depositor must sign it themselves.

# --- running your own relayer (pnpm relayer) ---
# Signing key for the relayer's own Stacks account. This account pays fees;
# fund it. It never touches user funds.
RELAYER_PRIVATE_KEY=
RELAYER_ADDRESS=
# Address the protocol contracts are deployed under.
CONTRACT_DEPLOYER=
RELAYER_PORT=8787
# micro-STX the relayer pays per submitted transaction
RELAYER_TX_FEE=10000
# Optional: enables the BullMQ queue. Omit to use the in-process queue.
REDIS_URL=

# --- using relayers from the SDK ---
# Comma-separated name=url pairs. Two or more removes any single point of
# censorship: if one refuses or is down, the SDK fails over to the next.
#   STX_SHIELD_RELAYERS=R1=https://r1.example.com,R2=https://r2.example.com
STX_SHIELD_RELAYERS=
# random | ordered | <relayer name>
STX_SHIELD_RELAYER_SELECTION=random
