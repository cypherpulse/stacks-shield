# =============================================================================
# STX Shield relayer (Phase 10) -- environment TEMPLATE
# =============================================================================
# Copy to `.env.relayer` (gitignored) and fill the SECRET fields. The values
# below are the ones used for testnet testing; SECRET fields are placeholders.

NODE_ENV=production
LOG_LEVEL=info
# On Render, either set this to Render's assigned $PORT or let the code read PORT.
RELAYER_PORT=8787

# ---- Stacks (testnet) -------------------------------------------------------
STACKS_NETWORK=testnet
STACKS_API_URL=https://api.testnet.hiro.so

# ---- Relayer account --------------------------------------------------------
# SECRET: the relayer account's Stacks private key (hex). Fund this address with
#   STX for gas. To submit operations only, ANY funded account works. To ALSO
#   publish aggregation roots, it must be a registered relayer (see below).
RELAYER_PRIVATE_KEY=<relayer-private-key-hex>
# The relayer account's ST... address (public). If you use the deployer as the
# relayer, this equals CONTRACT_DEPLOYER below.
RELAYER_ADDRESS=<relayer-ST-address>

# Frozen protocol deployer (contracts live under it) -- the live testnet deploy.
CONTRACT_DEPLOYER=ST18XMPE0PS5VNEEKB82BPW7NRZRHXEPH16JK8NN6

# micro-STX fee the relayer pays per transaction (30000 = 0.03 STX; used in tests)
RELAYER_TX_FEE=30000
# Fee treasury address (informational).
TREASURY_ADDRESS=

# ---- Queue ------------------------------------------------------------------
# Omit REDIS_URL to use the in-memory queue (fine for a single instance).
# Point it at a Redis instance (Render Redis / Upstash) for durability.
# REDIS_URL=redis://localhost:6379

# ---- Transaction manager (values used in tests) -----------------------------
RELAYER_RETRIES=3
RELAYER_POLL_MS=30000
RELAYER_TIMEOUT_MS=900000

# ---- zkVerify root publication ----------------------------------------------
# false = submit operations only (recommended for a non-registered account).
# true  = also publish aggregation roots (requires a REGISTERED relayer account,
#         i.e. the deployer, or one added via zk-verifier.add-relayer).
RELAYER_PUBLISH_ROOTS=false
# Only needed when RELAYER_PUBLISH_ROOTS=true. SECRET: zkVerify (Volta) seed phrase.
ZKVERIFY_SEED_PHRASE=<zkverify-seed-phrase-only-if-publishing-roots>
# Custom zkVerify RPC (must be ws:// or wss://). Blank = built-in public Volta.
#   public Volta: wss://zkverify-volta-rpc.zkverify.io
#   Ankr (API key): wss://rpc.ankr.com/zkverify_volta_testnet/ws/<API_KEY>
ZKVERIFY_ENDPOINT=
# true  = connect through ZKVERIFY_ENDPOINT above; false = ignore it, use Volta.
# Defaults to true when ZKVERIFY_ENDPOINT is set, false when it is blank.
ZKVERIFY_USE_API=
# false = poll only (Volta's public RPC exposes no live subscription API).
ZKVERIFY_USE_SUBSCRIPTIONS=false
ZKVERIFY_DOMAIN_ID=0
ZKVERIFY_POLL_MS=10000

# ---- Multi-relayer failover (optional) --------------------------------------
# CSV of peer relayer URLs, or RELAYER_1..N.
STX_SHIELD_RELAYERS=
RELAYER_ID=
