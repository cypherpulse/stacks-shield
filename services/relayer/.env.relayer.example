# =============================================================================
# STX Shield relayer (Phase 10) -- environment
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info
RELAYER_PORT=8787

# Stacks
STACKS_NETWORK=testnet
STACKS_API_URL=https://api.testnet.hiro.so

# Relayer account (MUST be a registered aggregation relayer in zk-verifier)
RELAYER_PRIVATE_KEY=
RELAYER_ADDRESS=
CONTRACT_DEPLOYER=ST2HXRZ8A82JJAP14KD83JEXNRCF34J67088WJSJH
RELAYER_TX_FEE=25000
TREASURY_ADDRESS=

# Queue (omit REDIS_URL to use the in-memory driver on a single node)
REDIS_URL=redis://localhost:6379

# Transaction manager
RELAYER_RETRIES=3
RELAYER_POLL_MS=30000
RELAYER_TIMEOUT_MS=900000

# zkVerify root publication
RELAYER_PUBLISH_ROOTS=true
ZKVERIFY_ENDPOINT=
ZKVERIFY_SEED_PHRASE=
ZKVERIFY_DOMAIN_ID=0
ZKVERIFY_POLL_MS=10000

# Multi-relayer failover (either a CSV in STX_SHIELD_RELAYERS, or RELAYER_1..N)
STX_SHIELD_RELAYERS=
# RELAYER_1=https://relayer-a.example
# RELAYER_2=https://relayer-b.example
RELAYER_ID=
