# =============================================================================
# STX Shield API -- local env template
# =============================================================================
# Copy to `.env` (gitignored) to run the API locally. In production these are
# set in the host dashboard (Render), not in a file.
#
#   cp .env.example .env   # then fill DATABASE_URL

NODE_ENV=development
API_PORT=8888

# ---- REQUIRED ----
# Postgres connection string. Use your Neon URL (same DB the deployed API uses).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Any string >= 16 chars for local dev (production uses the Render value).
JWT_SECRET=local-dev-secret-change-me
# Frozen protocol deployer (the live testnet deploy).
CONTRACT_DEPLOYER=ST2HXRZ8A82JJAP14KD83JEXNRCF34J67088WJSJH

# ---- Optional (sensible defaults) ----
STACKS_NETWORK=testnet
HIRO_API_URL=https://api.testnet.hiro.so
# Turn the indexer off locally if you only want to serve reads.
INDEXER_ENABLED=true
BLOCK_POLL_MS=10000
# CORS: "*" reflects any origin (fine for local); or a comma-separated allow-list.
CORS_ORIGINS=*
