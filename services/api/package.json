{
  "name": "@stx-shield/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STX Shield public read-only API + indexers (Phase 9). Never holds keys, never proves, never signs.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "indexer": "tsx src/indexers/runner.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@stacks/encryption": "^7.0.0",
    "@stacks/transactions": "^7.0.0",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.10.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
