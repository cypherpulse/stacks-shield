# =============================================================================
# STX Shield API (Phase 9) -- environment
# =============================================================================
NODE_ENV=development
API_PORT=8888
API_HOST=0.0.0.0

# PostgreSQL (Drizzle)
DATABASE_URL=postgres://stxshield:stxshield@localhost:5432/stxshield
DB_POOL_SIZE=10

# JWT (24h sessions, frontend-stored, no refresh)
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=24

# Stacks / Hiro (read-only)
STACKS_NETWORK=testnet
HIRO_API_URL=https://api.testnet.hiro.so
# HIRO_API_KEY=

# Frozen protocol deployer (contracts derived from this)
CONTRACT_DEPLOYER=ST18XMPE0PS5VNEEKB82BPW7NRZRHXEPH16JK8NN6

# Indexer
INDEXER_ENABLED=true
BLOCK_POLL_MS=10000
INDEXER_START_HEIGHT=0

# HTTP
CORS_ORIGINS=*
AUTH_NONCE_TTL_MINUTES=10
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
