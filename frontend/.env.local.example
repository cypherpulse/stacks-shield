# =============================================================================
# STX Shield frontend -- local env template
# =============================================================================
# The app ships with sensible defaults that point at the LIVE deployment, so it
# runs with no env at all. Copy this file to `.env.local` only when you want to
# override those defaults — e.g. to run the relayer locally for end-to-end
# testing of shield -> transfer -> split -> merge -> withdraw.
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored.

# Public read-only API (stats, indexers). Keep the live API unless self-hosting.
VITE_API_URL=https://stx-shield-api.onrender.com

# Relayer base URLs. Use VITE_RELAYER_URLS (comma-separated) to spread operation
# submission across all three relayers; the SDK fails over across the list. Base
# URLs only, no trailing /submit. For a single local relayer use VITE_RELAYER_URL.
VITE_RELAYER_URLS=https://relayer-1.example.com,https://relayer-2.example.com,https://relayer-3.example.com
# VITE_RELAYER_URL=http://localhost:8787

# zkVerify submitter = a relayer's POST /submit. Defaults to the FIRST relayer in
# the list above. Leave blank to reuse that default.
VITE_ZKVERIFY_URL=

# Network (testnet only for now).
VITE_NETWORK=testnet

# Testnet faucet (Hermes). Base defaults to the live faucet; the API key is NOT
# committed — set it here (kept out of git). Without a key the faucet endpoints
# will reject the request.
VITE_FAUCET_URL=https://hermes-faucet-backend.onrender.com/api/claim-stx
VITE_FAUCET_API_KEY=your-faucet-api-key
