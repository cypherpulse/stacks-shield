# =============================================================================
# STX Shield -- .gitignore
# =============================================================================

# ---- Secrets & environment (NEVER commit) ----------------------------------
# All .env files anywhere, EXCEPT the committed *.example templates.
.env
.env.*
!.env.example
!.env*.example
!**/.env.example
!**/.env*.example
# Local Clarinet network configs carry deployer mnemonics.
**/settings/Mainnet.toml
# CLI test harness note store — holds spend secrets.
cli-notes.json
**/cli-notes.json
# Generated account keys/mnemonics — never commit.
accounts.json
**/accounts.json
**/settings/Testnet.toml
# Any stray key / mnemonic dumps.
*.key
*.pem
*.mnemonic
secrets.*

.claude/
.cursor/
.aider*
history.txt

# ---- Dependencies -----------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases

# ---- Build output -----------------------------------------------------------
dist/
**/dist/
build/
out/
*.tsbuildinfo

deployments/devnet
deployments/mainnet
deployments/testnet


docs/

# ---- Noir / Barretenberg compiled artifacts (regenerated by `nargo compile`)
zk/circuits/**/target/
**/target/
**/proofout/
**/*.gz
**/vk/
!**/*.example

# ---- Test / coverage / reports ---------------------------------------------
coverage/
*.info
lcov.info
costs-reports.json
.vitest-tmp/
.nyc_output/
playwright-report/
test-results/

# ---- Databases / local infra ------------------------------------------------
*.sqlite
*.sqlite3
pgdata/
redisdata/

# ---- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Caches -----------------------------------------------------------------
.cache/
.cache/**
.turbo/
.parcel-cache/
.vite/

